{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Spry",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/spry.exe",
      "args": ["examples/basic"],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "externalTerminal"
    },
    {
      "name": "Debug (gdb/lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/spry",
      "args": ["examples/basic"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
